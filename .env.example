# Copie para .env.local e preencha. NUNCA comite o .env.local.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# URL e chave ANÔNIMA são públicas por natureza (vão para o browser). O que
# protege os dados é o RLS, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SERVICE ROLE — ignora RLS por completo. É a chave-mestra do banco.
# Só no servidor, só para provisionamento (criar usuário, convite). NUNCA
# prefixe com NEXT_PUBLIC_, nunca importe em componente de cliente.
# Deixe em branco enquanto o produto não precisar.
SUPABASE_SERVICE_ROLE_KEY=
